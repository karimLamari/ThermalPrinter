# ===========================================
# BimiPrint Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Backend WebSocket URL (required)
VPS_URL=wss://your-backend.com/print

# Restaurant identifier (used for WebSocket auth)
RESTAURANT_CODE=MYRESTAURANT

# Shared secret with the backend (sent as x-bimiprint-token header). Must match the
# backend's BIMIPRINT_TOKEN. Leave empty while the backend has no token configured.
BIMIPRINT_TOKEN=

# Printer configuration
PRINTER_TYPE=network
PRINTER_ADDRESS=192.168.1.100

# WiFi configuration (optional - can also be set via web portal)
WIFI_SSID=
WIFI_PASSWORD=

# Config file path (optional - default: /etc/bimiprint/config.json)
# CONFIG_PATH=/etc/bimiprint/config.json
